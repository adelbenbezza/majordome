# Copy this file to .env for local development and fill in the values.
# On Railway, set these in the service's "Variables" tab instead.

# --- Required ---------------------------------------------------------------

# Token of your bot, given by @BotFather on Telegram.
TELEGRAM_BOT_TOKEN=

# OpenAI key, used for voice transcription (Whisper). https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Anthropic key, used to understand your messages (Claude). https://console.anthropic.com/
ANTHROPIC_API_KEY=

# --- Optional ---------------------------------------------------------------

# Your numeric Telegram user ID. If left empty, the first person to send /start
# to the bot becomes its owner (saved in the database). Everyone else is ignored.
OWNER_TELEGRAM_ID=

# Your starting timezone. You can change it later by telling the bot ("I live in Montreal").
TIMEZONE=Europe/Paris

# Where the SQLite database file lives. On Railway, leave empty: if a volume is
# attached, the database is stored on it automatically.
DATABASE_PATH=

# Claude model used to understand messages.
CLAUDE_MODEL=claude-haiku-4-5

# true = Full edition (web dashboard), false = Lite edition (bot only).
ENABLE_DASHBOARD=false
